# YouCam API (hackathon: redeem 1,000 units in API console)
# Powers virtual try-on (cloth-v4) and post-fitting skin tone / colour analysis (skin-tone-analysis).
YOUCAM_API_KEY=

# Optional override (default: https://yce-api-01.makeupar.com)
# YOUCAM_API_BASE_URL=

# Public URL of this app (used in dashboard embed snippet)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Practice orders. Server only. Never put the secret key in a NEXT_PUBLIC_ variable.
# The AuraFit tables already exist. Set the project URL and the secret key from
# Project Settings → API Keys. Do not use the publishable key here.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=

# Customer photo backgrounds are removed on the server with
# @imgly/background-removal-node. It is free, has no usage cap, and needs no API key.
# The first request downloads the model into node_modules (about 80MB).

# Optional. Used only when a shopper asks for an AI assumption of a missing garment back.
# Photta ghost-mannequin, angle "back". Credits are limited. Leave blank to skip generation.
# PHOTTA_API_KEY=
